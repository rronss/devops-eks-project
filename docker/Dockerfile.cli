# =============================================
# Production Dockerfile for SeyoAWE CLI (sawectl)
# =============================================
# Tests run in Jenkins (unit, integration, E2E) before this image is pushed.

FROM python:3.12-slim

ARG VERSION=unknown
LABEL maintainer="rronss"
LABEL description="SeyoAWE CLI Tool (sawectl)"
LABEL org.opencontainers.image.version="${VERSION}"

WORKDIR /app

RUN groupadd -r seyoawe && useradd -r -g seyoawe -d /app seyoawe

COPY cli/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY cli/sawectl.py .
COPY cli/dsl.schema.json .
COPY cli/module.schema.json .
COPY VERSION .

USER seyoawe

ENTRYPOINT ["python", "sawectl.py"]